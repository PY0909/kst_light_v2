# 数据与结果（原始数据 208MB 超 GitHub 100MB 单文件限制，严禁入库）
dataset/
results/
archive/
vendor/

# Python 缓存
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 系统文件
.DS_Store

# 压缩包与打包产物
*.zip

# 本机环境配置（记录建议值用 .env.example，实际值不入库）
.env
.envrc

# 旧默认输出根（runtime_paths 遗留命名，防程序产物误入库）
result/

