# kst_light_v2 运行时路径（复制为 .env 或在 shell profile 中设置；实际值不入库）
# 优先级：CLI > environment > config > repository-relative default

# 本机（macOS）建议值
KST_PROJECT_ROOT=/Users/ppy/研/kst_light_v2
KST_DATA_ROOT=/Users/ppy/研/kst_light_v2/dataset
KST_RESULT_ROOT=/Users/ppy/研/kst_light_v2/results

# AutoDL 示例（按实际数据盘调整）：
# export KST_PROJECT_ROOT=/root/autodl-tmp/kst_light_v2
# export KST_DATA_ROOT=/root/autodl-tmp/kst_light_v2/dataset
# export KST_RESULT_ROOT=/root/autodl-tmp/kst_light_v2/results
